rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with Google (anonymous or signed-out users have no auth uid)
    function signedIn() {
      return request.auth != null;
    }

    // Is the signed-in user in this household's members list?
    function isMember(h) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(h)).data.members;
    }

    // Each user can only see and change their own record (which household they are in)
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // An invite code can be looked up by anyone signed in who knows it. Listing is not allowed.
    match /invites/{code} {
      allow get: if signedIn();
      allow create, update: if isMember(request.resource.data.householdId);
      allow delete: if isMember(resource.data.householdId);
    }

    match /households/{h} {
      // Members can read the household doc, but nobody can list all households
      allow get: if signedIn() && request.auth.uid in resource.data.members;

      // Start a household with only yourself in it
      allow create: if signedIn() &&
        request.resource.data.members == [request.auth.uid] &&
        request.resource.data.names.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.names.keys().hasAll([request.auth.uid]);

      // Households are never deleted
      allow delete: if false;

      allow update:
        // A member can rename, or remove people, but must never empty the household
        if (isMember(h) && request.resource.data.members.size() > 0)
        // Or a new person joins with a valid, unexpired invite for this household.
        // They may only add themselves, and only change members, names and joinedWith.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'joinedWith']) &&
          !(request.auth.uid in resource.data.members) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]) &&
          exists(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)) &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)).data.householdId == h &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)).data.expires > request.time
        );

      // Everything inside a household (packs, shop, meals, sheets, ratings, foods, inbox).
      // Needs a subcollection name first, so this never matches the household doc itself
      // (a plain {sub=**} would also match it and skip the checks above).
      match /{coll}/{rest=**} {
        allow read, write: if isMember(h);
      }
    }

    // Anything not matched above is denied by default
  }
}
